{
  "title": "Der Brief",
  "subtitle": "Eine Kurzgeschichte auf Deutsch",
  "level": "C1",
  "voices": {
    "narrator": {"voice": "de-DE-FlorianMultilingualNeural", "rate": "-10%", "pitch": "-3Hz", "fx": "narrator"},
    "lorenz":   {"voice": "de-DE-KillianNeural",             "rate": "-12%", "pitch": "-2Hz", "fx": "room"},
    "brother":  {"voice": "de-DE-ConradNeural",              "rate": "-6%",  "pitch": "+0Hz", "fx": "phone"}
  },
  "vocab": [
    "unter", "keinen", "umständen", "allmählich", "anweisung", "gegolten", "beharrlich", "unumstößliche",
    "unmissverständlich", "gestand", "sterben", "abzuwälzen", "nachgeschobenes", "unvermittelt",
    "durchnässte", "zaghafte", "kränkung", "prinzipientreue", "verklärt", "ressentiment", "vermeintlich",
    "deutungshoheit", "zerwürfnis", "beanspruchte", "einsicht", "unversöhnlichkeit", "preis", "vergeben",
    "schwieg", "verzeihen", "widersprechen", "umzudrehen"
  ],
  "lines": [
    {"id": "L01", "voice": "narrator", "pause": 0.35,
     "chunks": [["Auf dem Umschlag stand,", "On the envelope, it said,"],
                ["in seiner eigenen Handschrift:", "in his own handwriting:"]]},
    {"id": "L02", "voice": "narrator", "rate": "-18%", "pause": 1.15, "handwriting": true,
     "chunks": [["„Unter keinen Umständen antworten.“", "“Do not reply under any circumstances.”"]]},
    {"id": "L03", "voice": "narrator", "pause": 0.85,
     "chunks": [["Lorenz begriff erst allmählich,", "Only gradually did Lorenz realize"],
                ["wem diese Anweisung gegolten hatte.", "who this instruction had been meant for."]]},
    {"id": "L04", "voice": "narrator", "rate": "-20%", "pause": 3.4,
     "chunks": [["Ihm selbst.", "Himself."]]},

    {"id": "L05", "voice": "narrator", "pause": 0.55,
     "chunks": [["Vierzehn Jahre lang hatte er behauptet,", "For fourteen years, he had claimed"],
                ["sein Bruder habe sich niemals entschuldigt.", "that his brother had never apologized."]]},
    {"id": "L06", "voice": "narrator", "pause": 1.1,
     "chunks": [["Er wiederholte es so beharrlich,", "He repeated it so persistently"],
                ["dass die Familie seine Version längst", "that the family had long since taken his version"],
                ["für eine unumstößliche Tatsache hielt.", "for an irrefutable fact."]]},
    {"id": "L07", "voice": "narrator", "pause": 0.75,
     "chunks": [["Dabei war der Brief unmissverständlich.", "And yet the letter was unmistakable."]]},
    {"id": "L08", "voice": "narrator", "pause": 0.7,
     "chunks": [["Sein Bruder gestand,", "His brother confessed"],
                ["Lorenz allein gelassen zu haben,", "to having left Lorenz alone"],
                ["als ihr Vater im Sterben lag.", "when their father was dying."]]},
    {"id": "L09", "voice": "narrator", "pause": 0.45,
     "chunks": [["Kein Versuch, die Schuld abzuwälzen.", "No attempt to shift the blame."]]},
    {"id": "L10", "voice": "narrator", "pause": 1.7,
     "chunks": [["Kein nachgeschobenes „Aber“.", "No “but” tacked on at the end."]]},

    {"id": "L11", "voice": "narrator", "pause": 0.5,
     "chunks": [["Unvermittelt kehrte jener Abend zurück:", "Without warning, that evening came back:"]]},
    {"id": "L12", "voice": "narrator", "pause": 1.6,
     "chunks": [["das kalte Treppenhaus,", "the cold stairwell,"],
                ["der durchnässte Mantel,", "the soaked coat,"],
                ["das zaghafte Klopfen.", "the timid knocking."]]},
    {"id": "L13", "voice": "narrator", "pause": 0.5,
     "chunks": [["Lorenz hatte die Zeilen bereits gelesen.", "Lorenz had already read the lines."]]},
    {"id": "L14", "voice": "narrator", "pause": 1.9,
     "chunks": [["Trotzdem blieb die Tür verschlossen.", "Even so, the door stayed shut."]]},

    {"id": "L15", "voice": "narrator", "pause": 0.65,
     "chunks": [["Mit den Jahren hatte er seine Kränkung", "Over the years, he had glorified his hurt"],
                ["zur Prinzipientreue verklärt.", "into loyalty to his principles."]]},
    {"id": "L16", "voice": "narrator", "pause": 1.1,
     "chunks": [["Aus Schmerz war Ressentiment geworden;", "Pain had turned into resentment;"],
                ["aus Ressentiment ein vermeintlich", "resentment into a supposedly"],
                ["moralischer Standpunkt.", "moral standpoint."]]},
    {"id": "L17", "voice": "narrator", "pause": 0.55,
     "chunks": [["Indem er die Deutungshoheit", "By claiming the sole right to interpret"],
                ["über ihr Zerwürfnis beanspruchte,", "their falling-out,"],
                ["bewahrte er sich vor einer", "he spared himself"],
                ["unangenehmen Einsicht:", "an uncomfortable insight:"]]},
    {"id": "L18", "voice": "narrator", "pause": 2.0,
     "chunks": [["Auch seine Unversöhnlichkeit", "His own refusal to forgive"],
                ["hatte einen Preis.", "had its price, too."]]},

    {"id": "L19", "voice": "narrator", "pause": 1.7,
     "chunks": [["Er wählte die alte Nummer.", "He dialed the old number."]]},
    {"id": "L20", "voice": "narrator", "pause": 2.3,
     "chunks": [["Sie war noch vergeben.", "It was still in service."]]},
    {"id": "L21", "voice": "lorenz", "pause": 0.3, "tts": "Ich habe deinen Brief damals gelesen.",
     "chunks": [["„Ich habe deinen Brief damals gelesen“,", "“I read your letter back then,”"]]},
    {"id": "L22", "voice": "narrator", "pause": 1.0,
     "chunks": [["sagte er, ohne Begrüßung.", "he said, without a greeting."]]},
    {"id": "L23", "voice": "narrator", "pause": 2.6,
     "chunks": [["Sein Bruder schwieg.", "His brother said nothing."]]},
    {"id": "L24", "voice": "narrator", "pause": 0.45,
     "chunks": [["Dann antwortete er:", "Then he answered:"]]},
    {"id": "L25", "voice": "brother", "pause": 2.0,
     "tts": "Dass du mir nicht verzeihen konntest, habe ich verstanden. Aber hör endlich auf, für uns beide zu erzählen, was geschehen ist.",
     "chunks": [["„Dass du mir nicht verzeihen konntest,", "“That you couldn’t forgive me –"],
                ["habe ich verstanden.", "I understood that."],
                ["Aber hör endlich auf,", "But stop, once and for all,"],
                ["für uns beide zu erzählen, was geschehen ist.“", "telling what happened for both of us.”"]]},

    {"id": "L26", "voice": "narrator", "pause": 0.9,
     "chunks": [["Lorenz wollte widersprechen.", "Lorenz wanted to object."]]},
    {"id": "L27", "voice": "narrator", "pause": 1.0,
     "chunks": [["Stattdessen legte er den Brief vor sich hin.", "Instead, he laid the letter down in front of him."]]},
    {"id": "L28", "voice": "narrator", "rate": "-16%", "pause": 0.0,
     "chunks": [["Zum ersten Mal,", "For the first time,"],
                ["ohne ihn umzudrehen.", "without turning it over."]]}
  ]
}
