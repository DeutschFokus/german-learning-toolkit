.imp{position:absolute;left:var(--outer);bottom:24mm;width:118mm;font-size:8.6pt;line-height:calc(var(--bl)*.875)}
.imp h3{margin-top:calc(var(--bl)*.875)} .imp .big{font-family:"DF Fraunces";font-weight:650;font-size:15pt;line-height:var(--bl)}
.imp .lg{margin-bottom:calc(var(--bl)*1)}
.lg{display:inline-flex;align-items:center;gap:2.2mm;white-space:nowrap} .lg-mark{display:block}
.lg-word{font-family:"DF Sans";font-weight:400;font-size:13pt;letter-spacing:.01em;line-height:1} .lg-word b{font-weight:800;margin-left:.22em}
.toc{margin-top:calc(var(--bl)*1)}
.toc .grp{font-size:6.8pt;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--mute);line-height:var(--bl);margin-top:calc(var(--bl)*.5)}
.toc .row{display:grid;grid-template-columns:6.4mm 1fr 56mm 12mm;column-gap:3mm;align-items:baseline;border-top:.5pt solid var(--line);padding:calc(var(--bl)*.125) 0;line-height:var(--bl)}
.toc .row .no{width:6.4mm;height:6.4mm;border-radius:1.5mm;background:var(--cm);font-family:"DF Fraunces";font-weight:800;font-size:9.5pt;line-height:6.4mm;text-align:center;align-self:center}
.toc .row .ti b{font-weight:700;font-size:11pt} .toc .row .ti span{font-style:italic;font-size:8.6pt;color:var(--mute);margin-left:2.4mm}
.toc .row .gr{font-size:7.8pt;color:var(--mute);line-height:calc(var(--bl)*.7)}
.toc .row .pg{text-align:right;font-family:"DF Fraunces";font-weight:800;font-size:11pt}
.toc .row.off .ti b,.toc .row.off .pg{color:var(--faint)} .toc .row.off .no{opacity:.45}
.toc .row.zs .no{background:var(--navy);color:#fff;border-radius:50%}
.toc .row.plain{grid-template-columns:1fr 12mm;padding:calc(var(--bl)*.25) 0} .toc .row.plain .ti b{font-size:10.5pt;font-weight:600}
.how .path{display:grid;grid-template-columns:repeat(7,1fr);gap:2mm;margin-top:calc(var(--bl)*.5)}
.how .stp{border-top:2.4pt solid var(--mid);padding-top:calc(var(--bl)*.25);font-size:7.8pt;line-height:calc(var(--bl)*.7);hyphens:auto}
.how .stp b{display:block;font-size:8.6pt;line-height:var(--bl)} .how .stp i{display:block;font-style:normal;font-family:"DF Fraunces";font-weight:800;font-size:15pt;line-height:var(--bl);color:var(--deep)}
.how .stp span{color:var(--mute)}
.how .sec{margin-top:calc(var(--bl)*1)}
.how h2{font-family:"DF Fraunces","DF Sans";font-weight:650;font-size:14pt;line-height:var(--bl)}
.how .expl{font-style:italic;font-size:var(--fs-ex);color:var(--mute);margin-top:calc(var(--bl)*.25)}
.how .demo{margin-top:calc(var(--bl)*.5);border:.6pt solid var(--line);border-radius:3mm;padding:calc(var(--bl)*.75) 5mm;position:relative}
.how .demo .task{grid-template-columns:var(--label) 1fr 0 0 !important}
.how .cal{margin-top:calc(var(--bl)*.5);display:grid;grid-template-columns:repeat(5,1fr);gap:3mm;font-size:7.8pt;line-height:calc(var(--bl)*.7);color:var(--mute)}
.how .cal b{display:inline-block;width:4.4mm;height:4.4mm;border-radius:50%;background:var(--ink);color:#fff;font-size:7pt;line-height:4.4mm;text-align:center;margin-right:1.2mm}
.how .pin{position:absolute;width:4.4mm;height:4.4mm;border-radius:50%;background:var(--ink);color:#fff;font-size:7pt;font-weight:700;line-height:4.4mm;text-align:center}
