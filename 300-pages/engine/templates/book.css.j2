.sthead .sub{font-style:italic;font-size:var(--fs-ex);color:var(--mute);line-height:var(--bl)}

/* ── front matter, appendix, sales ──────────────────────────────────────── */
.fm{position:absolute;left:var(--inner);top:{{ pg.top }}mm;width:var(--tw)} .verso .fm{left:var(--outer)}
.fm h1,.ax h1{font-family:"DF Fraunces","DF Sans";font-weight:620;font-size:30pt;line-height:calc(var(--bl)*3);letter-spacing:-.016em}
