.how .cd .smp{margin-top:calc(var(--bl)*.5)}
.how .icons{display:grid;grid-template-columns:repeat(6,1fr);gap:2mm;margin-top:calc(var(--bl)*.5);font-size:7.8pt;text-align:center;line-height:calc(var(--bl)*.75)}
.how .icons .ic{display:block;margin:0 auto 1mm}
.how .chips span{display:inline-block;padding:0 2.6mm;height:calc(var(--bl)*1.25);line-height:calc(var(--bl)*1.25);border-radius:1.6mm;margin-right:1.6mm;font-weight:700}
.how .chips .cder{background:var(--der-t);color:var(--der)} .how .chips .cdie{background:var(--die-t);color:var(--die)} .how .chips .cdas{background:var(--das-t);color:var(--das)} .how .chips .cpl{background:var(--pl-t);color:var(--pl)}
.how .mnl li{display:grid;grid-template-columns:27mm 1fr;font-size:8.6pt;line-height:var(--bl)}
.how .mnl .nh{font-size:6.6pt;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--nc)} .how .mnl .nh .ic{vertical-align:-1mm;margin-right:1mm}
