.match{display:grid;grid-template-columns:1fr 1fr;gap:0 8mm}
.match li{display:flex;align-items:flex-start;border-top:.5pt solid var(--line);padding:calc(var(--bl)*.25 - .5pt) 0 calc(var(--bl)*.25)}
