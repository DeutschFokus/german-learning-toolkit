.castg{gap:calc(var(--bl)*1.75) 8mm}
.sthead .intro{font-weight:600;line-height:var(--bl)}

/* ── baseline grid: rows are centred between their rules, so a table starts a quarter line low —
      that puts the text of every row back on the half-baseline grid ───────── */
.tf,.gram table,.tfill,.ooo,.match,.sortt{margin-top:calc(var(--bl)*.25);margin-bottom:calc(var(--bl)*.25)}
.pd-leg{margin-top:calc(var(--bl)*.75);margin-bottom:calc(var(--bl)*.25)}
.cards.listing{gap:calc(var(--bl)*.5);margin:calc(var(--bl)*.25) 0}
.cards.notecards.n1{gap:calc(var(--bl)*.5)}
