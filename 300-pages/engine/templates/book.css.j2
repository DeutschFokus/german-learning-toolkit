{#- ───────────────────────────────────────────────────────────────────────────
   300 Pages of German · stylesheet
   Every colour and size comes from series.yaml / levels/*.yaml via tokens.
   Vertical measures are multiples of half a baseline (--bl), so text on facing
   pages lines up.
   ─────────────────────────────────────────────────────────────────────────── -#}
{% for f in fonts %}
@font-face{font-family:"{{ f.family }}";src:url("{{ f.url }}");font-weight:{{ f.weight }};font-style:{{ f.style }}}
{% endfor %}
@page{size:{{ sheet_w }}mm {{ sheet_h }}mm;margin:0}
:root{
  --bl:{{ bl }}pt;--fs:{{ fs }}pt;--fs-ex:{{ fs_ex }}pt;--fs-note:{{ fs_note }}pt;--fs-read:{{ fs_read }}pt;--hw:{{ hw }}pt;--wl:{{ wl }}pt;
  --ink:{{ t.ink }};--mute:{{ t.mute }};--faint:{{ t.faint }};--line:{{ t.line }};--rule:{{ t.rule }};--grey:{{ t.grey }};
  --cream:{{ t.cream }};--navy:{{ t.navy }};--pen:{{ t.pen }};--bad:{{ t.bad }};
  --der:{{ t.der }};--die:{{ t.die }};--das:{{ t.das }};--pl:{{ t.pl }};
  --der-t:{{ t.der_tint }};--die-t:{{ t.die_tint }};--das-t:{{ t.das_tint }};--pl-t:{{ t.pl_tint }};
  --n-tipp:{{ t.n_tipp }};--n-wort:{{ t.n_wort }};--n-landeskunde:{{ t.n_landeskunde }};--n-sogehts:{{ t.n_sogehts }};
  --lv:{{ lv.cover }};--lv-lite:{{ lv.cover_lite }};--lv-deep:{{ lv.cover_deep }};--lv-bright:{{ lv.bright }};
  --inner:{{ pg.inner }}mm;--outer:{{ pg.outer }}mm;--tw:{{ tw }}mm;--main:{{ pg.main }}mm;--gap:{{ pg.gap }}mm;--mcol:{{ pg.margin_col }}mm;
  --label:{{ pg.label_col }}mm;--content:{{ content_w }}mm;--body-h:{{ body_h }}pt;
}
{% for name, c in palettes.items() %}
.{{ name }}{--mid:{{ c.mid }};--soft:{{ c.soft }};--wash:{{ c.wash }};--hl:{{ c.hl }};--strong:{{ c.strong }};--deep:{{ c.deep }}}
{% endfor %}
html,body{margin:0;padding:0}
body{font-family:"DF Sans",sans-serif;font-size:var(--fs);line-height:var(--bl);color:var(--ink);
  font-variant-numeric:lining-nums;hyphens:manual}
/* Fonts are static instances (tools/make_fonts.py). For Fraunces the weight picks the role:
   900 hero numerals · 800 small numerals · 650 box titles · 620 headings · 540 cover line · 500 text. */
p,h1,h2,h3,h4,ul,ol,dl,dd,figure{margin:0;padding:0}
ul,ol{list-style:none}
b,strong{font-weight:700}
a{color:inherit;text-decoration:none}
svg{display:inline-block}
table{border-collapse:collapse;border-spacing:0}
.fr{font-family:"DF Fraunces","DF Sans",serif}

/* ── sheet (print) and page ─────────────────────────────────────────────── */
.page{position:relative;width:{{ pg.width }}mm;height:{{ pg.height }}mm;overflow:hidden;break-after:page;background:#fff}
.sheet{position:relative;width:{{ sheet_w }}mm;height:{{ sheet_h }}mm;break-after:page;overflow:hidden;background:#fff}
.sheet .bleedbox{position:absolute;left:{{ pg.slug }}mm;top:{{ pg.slug }}mm;width:{{ pg.width + 2 * pg.bleed }}mm;height:{{ pg.height + 2 * pg.bleed }}mm;overflow:hidden}
.sheet .page{position:absolute;left:{{ pg.bleed }}mm;top:{{ pg.bleed }}mm;overflow:visible;break-after:auto}
.sheet .crop{position:absolute;background:#000}
.sheet .slugline{position:absolute;left:{{ pg.slug + pg.bleed + 6 }}mm;top:1.3mm;font-size:5.5pt;line-height:3mm;color:#000;letter-spacing:.04em}
.body{position:absolute;top:{{ pg.top }}mm;width:var(--tw);height:var(--body-h)}
.recto .body,.recto .rh,.recto .pw{left:var(--inner)} .verso .body,.verso .rh{left:var(--outer)}
.u{position:absolute;left:0;width:var(--tw)}

/* running header, progress strip, tab, folio */
.rh{position:absolute;top:{{ pg.header_top }}mm;width:var(--tw);height:5mm;font-size:7.6pt;line-height:5mm;letter-spacing:.11em;text-transform:uppercase;color:var(--mute);white-space:nowrap}
.recto .rh{text-align:right} .verso .rh{text-align:left}
.rh b{color:var(--ink);font-weight:700} .rh .sl{margin:0 .5em;color:var(--faint)}
.prog{position:absolute;top:1.9mm;height:1.3mm;font-size:0;white-space:nowrap}
.recto .prog{left:0} .verso .prog{right:0}
.prog i{display:inline-block;height:1.3mm;background:var(--line);margin-right:.7mm;border-radius:.4mm}
.prog i.on{background:var(--mid)} .prog i.here{background:var(--deep)}
.tab{position:absolute;width:{{ pg.tab.width + 3 }}mm;height:{{ pg.tab.height }}mm;background:var(--mid);color:var(--ink);font-family:"DF Fraunces";font-weight:800;font-size:11pt;line-height:{{ pg.tab.height }}mm;text-align:center}
.recto .tab{right:-3mm;border-radius:2mm 0 0 2mm;padding-right:3.6mm;box-sizing:border-box}
.verso .tab{left:-3mm;border-radius:0 2mm 2mm 0;padding-left:3.6mm;box-sizing:border-box}
.tab.st{background:var(--navy);color:#fff}
.folio{position:absolute;top:{{ pg.folio_top }}mm;font-family:"DF Fraunces";font-weight:700;font-size:12pt;line-height:6mm;white-space:nowrap}
.recto .folio{right:var(--outer);text-align:right} .verso .folio{left:var(--outer)}

/* words on this page */
.pw{position:absolute;top:{{ pg.footer_top }}mm;width:{{ pw_w }}mm;height:{{ pw_h }}mm;border-top:.5pt solid var(--line);padding-top:1.3mm;font-size:7.5pt;line-height:9.8pt;color:var(--mute);overflow:hidden}
.verso .pw{left:{{ pg.outer + tw - pw_w }}mm}
.pw .lab{display:block;font-size:6.2pt;line-height:8.6pt;font-weight:700;letter-spacing:.13em;text-transform:uppercase;color:var(--ink)}
.pw .lab i{font-style:normal;font-weight:400;letter-spacing:.04em;text-transform:none;color:var(--mute);margin-left:.6em}
.pw .w{display:inline-block;white-space:nowrap;margin-right:{{ pw_gap }}mm}
.pw .w b{color:var(--ink);font-weight:600} .pw .w em{font-style:italic}
.pw .more{font-style:italic}
.der{color:var(--der);font-weight:700} .die{color:var(--die);font-weight:700} .das{color:var(--das);font-weight:700} .pl{color:var(--pl);font-weight:700}
.np{white-space:nowrap}

/* ── Teil header ────────────────────────────────────────────────────────── */
.teil{display:grid;height:calc(var(--bl)*3)}
.recto .teil,.m .teil{grid-template-columns:var(--label) var(--content);margin-right:calc(var(--gap) + var(--mcol))}
.verso .teil{grid-template-columns:var(--label) var(--content);margin-left:calc(var(--gap) + var(--mcol))}
.teil .no{width:11.4mm;height:calc(var(--bl)*2.2);margin-top:calc(var(--bl)*.3);border-radius:2.4mm;background:var(--mid);font-family:"DF Fraunces";font-weight:800;font-size:19pt;line-height:calc(var(--bl)*2.2);text-align:center}
.teil .no.w2{font-size:15pt;letter-spacing:-.03em}
.teil h2{font-family:"DF Fraunces","DF Sans";font-weight:620;font-size:21pt;line-height:calc(var(--bl)*2);letter-spacing:-.012em;white-space:nowrap}
.teil .sub{font-style:italic;font-size:var(--fs-ex);color:var(--mute);line-height:var(--bl);white-space:nowrap}

/* ── task grid: label · content · margin (mirrored on left pages) ───────── */
.task{display:grid}
.recto .task,.m .task{grid-template-columns:var(--label) var(--content) var(--gap) var(--mcol)}
.verso .task{grid-template-columns:var(--mcol) var(--gap) var(--label) var(--content)}
.recto .tk-l,.m .tk-l{grid-column:1;grid-row:1} .recto .tk-m,.m .tk-m{grid-column:2;grid-row:1} .recto .mn,.m .mn{grid-column:4;grid-row:1}
.verso .tk-l{grid-column:3;grid-row:1} .verso .tk-m{grid-column:4;grid-row:1} .verso .mn{grid-column:1;grid-row:1}
.addr{display:block;width:12.6mm;height:var(--bl);font-size:0;white-space:nowrap}
.addr i{display:inline-block;vertical-align:top;width:7mm;font-style:normal;font-size:7.4pt;font-weight:600;line-height:var(--bl);color:var(--deep);letter-spacing:.02em}
.addr.long i{width:8.2mm;font-size:6.6pt;letter-spacing:0}
.addr b{display:inline-block;vertical-align:top;width:5.3mm;height:5.3mm;margin-top:calc((var(--bl) - 5.3mm)/2);border-radius:50%;background:var(--mid);font-size:9pt;font-weight:700;line-height:5.3mm;text-align:center;color:var(--ink)}
.skills{display:block;height:var(--bl);font-size:0;white-space:nowrap;padding-top:calc((var(--bl) - 5.2mm)/2);box-sizing:border-box}
.skills .ic{margin-right:1.1mm;color:var(--ink)}
.rub{display:flex;justify-content:space-between;align-items:flex-start}
.rub .de{font-weight:700;flex:1}
.rub .de i{font-style:italic}
.meta{flex:none;margin-left:3mm;font-size:8pt;line-height:var(--bl);white-space:nowrap;color:var(--mute)}
.score{display:inline-block;vertical-align:top;margin-top:1.6pt;height:11.8pt;line-height:11.8pt;padding:0 1.6mm 0 5.4mm;border:.6pt solid var(--rule);border-radius:1.2mm;font-weight:600;color:var(--ink);background:#fff}
.lkey{display:inline-block;vertical-align:top;margin-top:1.6pt;margin-left:1.2mm;height:11.8pt;line-height:11.8pt;padding:0 1.7mm;border-radius:1.2mm;background:var(--soft);color:var(--deep);font-weight:700;border:.6pt solid var(--soft)}
.ex{font-style:italic;font-size:var(--fs-ex);color:var(--mute)}
.ex .dw,.note .dw,.why .dw,.rule .dw,.card-ex .dw{font-style:normal;font-weight:600;color:var(--ink)}
.tk-b{margin-top:calc(var(--bl)*.5)}
.tk-b>*+*{margin-top:calc(var(--bl)*.5)}
.boxu .tk-b{margin-top:0}

/* ── margin notes and audio card ────────────────────────────────────────── */
.mn{font-size:var(--fs-note);line-height:calc(var(--bl)*.75);color:var(--ink);hyphens:auto}
.note{border-top:1.1pt solid var(--nc);padding-top:2.6pt;margin-bottom:calc(var(--bl)*.75)}
.note:last-child{margin-bottom:0}
.note .nh{display:block;font-size:6.6pt;line-height:calc(var(--bl)*.75);font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--nc);hyphens:manual}
.note .nh .ic{vertical-align:-1mm;margin-right:1mm}
.note.tipp{--nc:var(--n-tipp)} .note.wort{--nc:var(--n-wort)} .note.landeskunde{--nc:var(--n-landeskunde)} .note.sogehts{--nc:var(--n-sogehts)}
.note .wh{display:block;hyphens:manual} .note .wh b{font-weight:700} .note .wh em{font-style:italic;color:var(--mute)}
.audio{display:grid;grid-template-columns:15mm 1fr;gap:2.6mm;align-items:center;border:.6pt solid var(--rule);border-radius:2.4mm;padding:2mm;margin-bottom:calc(var(--bl)*.75);color:var(--ink);height:calc(var(--bl)*3.75 - 4mm - 1.2pt)}
.audio .qr{display:block;width:15mm;height:15mm}
.audio .tl{display:block;font-size:6.4pt;line-height:9pt;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--mute)}
.audio .tn{display:block;font-family:"DF Fraunces";font-weight:800;font-size:15pt;line-height:17pt}
.audio .td{display:block;font-size:7.4pt;line-height:10pt;color:var(--mute)} .audio .td .ic{vertical-align:-.9mm;margin-right:.8mm}

/* ── dialogue ───────────────────────────────────────────────────────────── */
.dlg{background:var(--wash);border-radius:3mm;padding:calc(var(--bl)*.5) 4mm}
.turn{display:grid;grid-template-columns:11.2mm 1fr;min-height:8.6mm;align-items:start;margin-bottom:calc(var(--bl)*.25)}
.turn:last-child{margin-bottom:0}
.turn .av{display:block;width:8.6mm;height:8.6mm}
.turn p{padding-top:calc((8.6mm - var(--bl))/2)}
.turn .sp{font-weight:700;font-size:7.6pt;letter-spacing:.08em;text-transform:uppercase;color:var(--deep);margin-right:2mm}

/* ── reading texts ──────────────────────────────────────────────────────── */
.read{border:.6pt solid var(--rule);border-radius:3mm;overflow:hidden;background:#fff}
.read .hd{background:var(--wash);padding:calc(var(--bl)*.5 - .6pt) 5mm calc(var(--bl)*.5);font-size:8.6pt;line-height:var(--bl);color:var(--mute)}
.read .hd b{color:var(--ink);font-weight:600;display:inline-block;width:13mm;font-size:7pt;letter-spacing:.1em;text-transform:uppercase}
.read .hd .sep{margin:0 3mm;color:var(--rule)} .read .hd .subj{color:var(--ink);font-weight:600}
.read .tx{position:relative;padding:calc(var(--bl)*.5) 5mm calc(var(--bl)*.5 - .6pt) 11mm;font-family:"DF Serif",serif;font-size:var(--fs-read);line-height:var(--bl)}
.read.nonum .tx{padding-left:5mm}
.read .tx p+p{margin-top:calc(var(--bl)*.5)}
.read .ln{position:absolute;left:2mm;width:6mm;text-align:right;font-family:"DF Sans";font-size:7.2pt;font-weight:700;color:var(--mute);line-height:var(--bl)}
.la{display:inline}
.read.notice{border:0;background:var(--grey);border-radius:1.2mm}
.read.notice .nt{padding:calc(var(--bl)*.5) 5mm 0 11mm;font-family:"DF Sans";font-weight:800;font-size:11.5pt;line-height:var(--bl);letter-spacing:.01em}
.read.notice.nonum .nt{padding-left:5mm}
.read.notice .pinrow{position:absolute;left:50%;top:1.6mm;width:3mm;height:3mm;margin-left:-1.5mm;border-radius:50%;background:var(--mid)}
.read.notice{position:relative}
.read.article{border:0;border-top:1.6pt solid var(--ink);border-radius:0}
.read.article .ah{padding:calc(var(--bl)*.5 - 1.6pt) 0 0 11mm}
.read.article .kick{font-size:6.8pt;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--deep);line-height:var(--bl)}
.read.article .hl{font-family:"DF Fraunces";font-weight:650;font-size:17pt;line-height:calc(var(--bl)*1.5);letter-spacing:-.01em}
.read.article .tx{padding-right:0}
.cards{display:grid;gap:3mm}
.cards.n1{grid-template-columns:1fr} .cards.n2{grid-template-columns:1fr 1fr} .cards.n3{grid-template-columns:1fr 1fr 1fr}
.card{position:relative;border-radius:2.4mm;padding:calc(var(--bl)*.5) 3.4mm;font-size:calc(var(--fs) - .9pt)}
.listing .card{border:.6pt solid var(--rule);background:#fff}
.card .cl{position:absolute;right:2.4mm;top:calc(var(--bl)*.5);width:5.4mm;height:5.4mm;border-radius:1.2mm;background:var(--mid);font-weight:700;font-size:9pt;line-height:5.4mm;text-align:center}
.card .ct{display:block;font-weight:700;padding-right:7mm}
.notecards .card{background:var(--wash);border-radius:1mm;font-family:"DF Hand";font-size:calc(var(--hw) - 1.5pt);line-height:var(--bl);font-weight:500;padding:calc(var(--bl)*.5) 3.6mm}
.notecards .card .ct{font-weight:700;padding-right:0}
.notecards .card .au{display:block;text-align:right;font-weight:500}
.notecards .card .cl{background:#fff;font-family:"DF Sans";top:auto;bottom:calc(var(--bl)*.5);right:auto;left:3mm;width:4.6mm;height:4.6mm;line-height:4.6mm;font-size:8pt;border-radius:50%}
.notecards .card.has-au.has-cl .au{padding-left:7mm}
.chat{background:var(--grey);border-radius:3mm;padding:calc(var(--bl)*.5) 4mm}
.msg{display:grid;grid-template-columns:9.6mm 1fr;margin-bottom:calc(var(--bl)*.25);min-height:var(--bl)}
.msg:last-child{margin-bottom:0}
.msg .av{display:block;width:7mm;height:7mm;margin-top:calc((var(--bl)*1.5 - 7mm)/2)}
.msg .bub{justify-self:start;max-width:82%;background:#fff;border-radius:3mm 3mm 3mm .8mm;padding:calc(var(--bl)*.25) 3mm}
.msg.me{grid-template-columns:1fr 9.6mm} .msg.me .av{grid-column:2;grid-row:1;justify-self:end}
.msg.me .bub{grid-column:1;grid-row:1;justify-self:end;background:var(--soft);border-radius:3mm 3mm .8mm 3mm}

/* ── boxes ──────────────────────────────────────────────────────────────── */
.gram{background:var(--wash);border-radius:3mm;padding:calc(var(--bl)*.5) 4.5mm}
.gram .gh{display:flex;align-items:center;gap:2mm;height:var(--bl);margin-bottom:calc(var(--bl)*.5)}
.gram .gh .lab,.lab{font-size:6.8pt;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--deep);line-height:var(--bl)}
.gram .gh .tt{font-family:"DF Fraunces";font-weight:650;font-size:12.5pt}
.gram table{width:100%}
.gram th{font-size:7pt;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--mute);text-align:left;padding:0 2mm 0 0;line-height:var(--bl)}
.gram td{padding:calc(var(--bl)*.25 - .5pt) 2mm calc(var(--bl)*.25) 0;border-top:.5pt solid var(--rule);vertical-align:top}
.gram td.rh1{width:24mm;font-weight:600}
.gram .gl{margin-top:calc(var(--bl)*.5);border-top:.5pt solid var(--rule);padding-top:calc(var(--bl)*.5 - .5pt)}
.gram table+.gl{margin-top:0}
.gram .gn{font-size:calc(var(--fs) - 1pt);color:var(--mute);white-space:pre-wrap} .gram .gn b{color:var(--ink)}
.gram .rule{margin-top:calc(var(--bl)*.5);font-style:italic;font-size:var(--fs-ex);color:var(--mute)}
mark{background:var(--hl);color:var(--ink);font-weight:700;padding:0 .7mm;margin:0 -.7mm;border-radius:.9mm}
.err{background:var(--grey);border-radius:3mm;padding:calc(var(--bl)*.5) 4.5mm}
.err .eh{font-size:6.8pt;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--ink);line-height:var(--bl)}
.err .eh .ic{vertical-align:-1mm;margin-right:1.2mm}
.err .row{position:relative;padding-left:7mm}
.err .sym{position:absolute;left:0;top:calc((var(--bl) - 4.4mm)/2);width:4.4mm;height:4.4mm;border-radius:50%}
.err .sym .ic{position:absolute;left:.7mm;top:.7mm}
.err .sym.no{background:#fff;color:var(--bad)} .err .sym.ok{background:var(--ink);color:#fff}
.err .wrong{color:var(--mute);text-decoration:line-through;text-decoration-color:var(--bad)}
.err .why{padding-left:7mm;font-style:italic;font-size:var(--fs-ex);color:var(--mute)}
.strike{text-decoration:line-through;text-decoration-color:var(--bad)}
.phr{background:var(--wash);border-radius:3mm;padding:calc(var(--bl)*.5) 4.5mm}
.phr .gh{display:flex;align-items:center;gap:2mm;height:var(--bl);margin-bottom:calc(var(--bl)*.25)}
.phr .gh .tt{font-family:"DF Fraunces";font-weight:650;font-size:12.5pt}
.phg{margin-top:calc(var(--bl)*.5)} .phg:first-of-type{margin-top:0}
.phg h4{font-size:6.8pt;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--deep);line-height:var(--bl)}
.phg .pr{display:grid;grid-template-columns:54% 46%;border-top:.5pt solid var(--rule);padding:calc(var(--bl)*.25 - .5pt) 0 0}
.phg .pr span:first-child{font-weight:600;padding-right:3mm}
.phg .pr span:last-child{font-style:italic;font-size:var(--fs-ex);color:var(--mute)}

/* ── write-in elements ──────────────────────────────────────────────────── */
.gap{display:inline-block;border:0;border-bottom:.7pt solid var(--ink);height:4.4mm;vertical-align:-1.6pt;margin:0 .8mm;box-sizing:border-box;background:transparent;padding:0;font-family:"DF Hand";font-size:calc(var(--hw) - 2pt);color:var(--pen)}
input.gap,textarea.wl,input.box{appearance:auto}
.gap.filled{text-align:center;border-bottom-color:var(--rule)}
.gap.filled .hw{font-family:"DF Hand";font-weight:500;font-size:calc(var(--hw) - 2pt);color:var(--pen);line-height:4.4mm;display:block}
.hint{font-style:italic;color:var(--mute);font-size:var(--fs-ex)}
.box{display:inline-block;width:4.3mm;height:4.3mm;border:.7pt solid var(--ink);border-radius:1mm;vertical-align:-1mm;background:#fff;box-sizing:border-box;margin:0}
.box.rd{border-radius:50%}
.ichs{white-space:nowrap} .ich{margin-right:3mm} .ich:last-child{margin-right:.6mm} .ich .box{margin-right:1.2mm}
.bank{display:flex;flex-wrap:wrap;gap:calc(var(--bl)*.25) 1.6mm}
.bank span{display:inline-block;height:var(--bl);padding:0 2.6mm;border:.6pt dashed var(--strong);border-radius:8mm;font-size:var(--fs-ex);line-height:calc(var(--bl) - 1.2pt);background:#fff;box-sizing:border-box}
.bank mark{padding:0 .3mm;margin:0;background:var(--hl)}
ol.items{counter-reset:it}
ol.items>li{counter-increment:it;padding-left:6mm;position:relative;margin-bottom:calc(var(--bl)*.5)}
ol.items>li:last-child{margin-bottom:0}
ol.items>li::before{content:counter(it);position:absolute;left:0;font-weight:700;color:var(--deep)}
ol.items.compact{display:grid;grid-template-columns:repeat(4,1fr);gap:calc(var(--bl)*.5) 3mm}
ol.items.compact>li{margin-bottom:0}
ol.items>li.exa::before{content:"";}
ol.items>li.exa{counter-increment:none}
.exa .tag{position:absolute;left:0;top:0;font-size:6.2pt;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--mute);line-height:var(--bl)}
.gaptext{line-height:calc(var(--bl)*1.5)}
.tf{width:100%}
.tf th{font-size:7pt;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--mute);text-align:center;padding:0;line-height:var(--bl)}
