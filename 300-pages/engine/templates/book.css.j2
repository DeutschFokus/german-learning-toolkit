.match .mr .k{width:6.5mm} .match .mr .k i{display:inline-block;width:4.5mm;height:4.5mm;border-radius:1.1mm;background:var(--mid);font-style:normal;font-size:7.4pt;line-height:4.5mm;text-align:center;color:var(--ink);margin-top:calc((var(--bl) - 4.5mm)/2);vertical-align:top}
.lines{position:relative;line-height:var(--wl)}
