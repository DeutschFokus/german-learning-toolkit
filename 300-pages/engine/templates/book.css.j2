.ph.strip{height:calc(var(--bl)*7)} .ph.wide{height:calc(var(--bl)*11)} .ph.square{height:calc(var(--bl)*12);width:calc(var(--bl)*12)} .ph.tall{height:calc(var(--bl)*16)}
