.lines .hl{display:block;height:var(--wl);border-bottom:.5pt solid var(--rule);box-sizing:border-box}
textarea.wl{position:absolute;left:0;display:block;width:100%;border:0;background:transparent;padding:0;margin:0;font-family:"DF Hand";font-size:var(--hw);line-height:var(--wl);color:var(--pen);resize:none;box-sizing:border-box}
