.ph.nocap .ph-cap span{display:none}

/* ── refinements after the first full render ────────────────────────────── */
mark{mix-blend-mode:multiply}
.ichs{margin-left:1.4mm}
.cards.listing{grid-template-columns:1fr;gap:1.6mm}
.listing .card{padding:calc(var(--bl)*.25 - .6pt) 3.4mm calc(var(--bl)*.25 - .6pt) 11mm;font-size:var(--fs)}
.listing .card .cl{left:3mm;right:auto;top:calc(var(--bl)*.25 - .6pt + (var(--bl) - 5.4mm)/2)}
